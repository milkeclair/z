{
  "name": "z-ls",
  "displayName": "z-ls",
  "author": "milkeclair",
  "publisher": "milkeclair",
  "description": "Language Server for z",
  "license": "MIT",
  "version": "2.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/milkeclair/z"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:shellscript"
  ],
  "main": "./client/dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "shellscript",
        "aliases": [
          "Shell Script",
          "shellscript"
        ],
        "extensions": [
          ".zsh"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "z-ls",
      "properties": {
        "z-ls.zPath": {
          "scope": "resource",
          "type": "string",
          "default": "~/.z",
          "description": "Fallback project directory when no workspace folder is supplied. Defaults to ~/.z"
        },
        "z-ls.completion.showPrivateFunctions": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Show private z functions in completion results."
        }
      }
    }
  },
  "scripts": {
    "b": "npm run clean && tsc -b",
    "test": "npm run b && tsc -p server/tsconfig.test.json --noEmit && TMPDIR=/tmp vitest run",
    "clean": "rm -rf client/dist server/dist client/tsconfig.tsbuildinfo server/tsconfig.tsbuildinfo",
    "vscode:prepublish": "npm run b",
    "package": "npm install --package-lock=false && rm -rf client/dist server/dist client/tsconfig.tsbuildinfo server/tsconfig.tsbuildinfo && vsce package"
  },
  "dependencies": {
    "glob": "^14.0.6",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
